<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bluma - Demon | Entine Cast</title>
  <link rel="stylesheet" href="styles.css">
  <link rel="stylesheet" href="styles-mobile.css" media="only screen and (max-width: 500px)">
  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background: linear-gradient(135deg, #3a1a1a 0%, #2c1111 100%);
      background-image: url('tavern-backround.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
      color: #DC143C;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      width: 100%;
      text-align: center;
      padding: 20px 0;
      background: rgba(44, 17, 17, 0.95);
      border-bottom: 2px solid #DC143C;
      box-shadow: 0 2px 8px #0004;
    }
    
    .home-link {
      display: inline-block;
      margin-bottom: 12px;
      padding: 10px 20px;
      background-color: #8B0000;
      color: white !important;
      border: none;
      border-radius: 8px;
      font-size: 1.08rem;
      font-family: inherit;
      cursor: pointer;
      box-shadow: 0 2px 8px #0003;
      text-decoration: none;
      transition: background 0.2s;
    }
    
    .home-link:hover {
      background-color: #A52A2A;
    }
    
    .character-title {
      font-size: 2.5rem;
      color: #DC143C;
      margin: 8px 0;
      text-shadow: 2px 2px 8px #000a;
      letter-spacing: 1px;
    }
    
    .character-subtitle {
      font-size: 1.2rem;
      color: #F08080;
      margin-bottom: 0;
      text-shadow: 1px 1px 4px #000a;
      font-style: italic;
    }

    /* Quick Reference Bar Enhanced */
    .quick-ref {
      background: rgba(44, 17, 17, 0.98);
      border: 3px solid #DC143C;
      border-radius: 16px;
      padding: 24px 32px;
      margin: 24px auto;
      max-width: 950px;
      box-shadow: 0 6px 20px #0008;
    }
    
    .quick-ref-title {
      text-align: center;
      color: #DC143C;
      font-size: 1.3rem;
      margin-bottom: 20px;
      font-weight: 600;
      text-shadow: 2px 2px 6px #000a;
      letter-spacing: 1px;
    }
    
    .quick-ref-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      text-align: center;
    }
    
    .quick-stat {
      background: rgba(0, 0, 0, 0.4);
      border-radius: 12px;
      padding: 16px;
      border: 2px solid #DC143C;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .quick-stat:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(220, 20, 60, 0.3);
    }
    
    .quick-stat-label {
      font-size: 0.95rem;
      color: #ccc;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 500;
    }
    
    .quick-stat-value {
      font-size: 1.2rem;
      color: #DC143C;
      font-weight: bold;
      text-shadow: 2px 2px 4px #000a;
    }

    /* Main Content Container */
    main {
      flex: 1;
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
      width: 95%;
    }

    /* Character Sections Grid */
    .character-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
      margin-top: 24px;
      max-width: 1000px;
      margin-left: auto;
      margin-right: auto;
    }

    .section {
      background: rgba(44, 17, 17, 0.96);
      border-radius: 18px;
      box-shadow: 0 8px 28px #000b;
      border: 2px solid #DC143C;
      padding: 28px;
      transition: transform 0.2s, box-shadow 0.2s;
      position: relative;
      overflow: hidden;
    }
    
    .section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #DC143C, #8B0000, #DC143C);
    }
    
    .section:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 36px #000d;
    }

    .section h2 {
      color: #DC143C;
      font-size: 1.5rem;
      margin: 0 0 20px 0;
      text-shadow: 2px 2px 6px #000a;
      border-bottom: 2px solid #DC143C;
      padding-bottom: 12px;
      text-align: center;
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .section p {
      color: #F08080;
      line-height: 1.7;
      font-size: 1.05rem;
      text-shadow: 1px 1px 3px #000a;
      margin-bottom: 14px;
    }
    
    .section ul {
      padding-left: 22px;
      color: #F08080;
    }
    
    .section li {
      margin-bottom: 10px;
      line-height: 1.6;
      text-shadow: 1px 1px 2px #000a;
    }

    /* Enhanced styling for different section types */
    .info-item {
      background: rgba(220, 20, 60, 0.12);
      border-left: 4px solid #DC143C;
      padding: 12px 16px;
      margin: 12px 0;
      border-radius: 6px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    
    .info-item strong {
      color: #DC143C;
      font-weight: 600;
    }
    
    .personality-trait {
      background: rgba(220, 20, 60, 0.12);
      border-left: 4px solid #DC143C;
      padding: 12px 16px;
      margin: 12px 0;
      border-radius: 6px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    
    .personality-trait strong {
      color: #DC143C;
      font-weight: 600;
    }
    
    .relationship-item {
      background: rgba(139, 0, 0, 0.15);
      border-left: 4px solid #8B0000;
      padding: 12px 16px;
      margin: 12px 0;
      border-radius: 6px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    
    .relationship-item strong {
      color: #CD5C5C;
      font-weight: 600;
    }
    
    .goal-item {
      background: rgba(128, 0, 128, 0.15);
      border-left: 4px solid #800080;
      padding: 12px 16px;
      margin: 12px 0;
      border-radius: 6px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    
    .goal-item strong {
      color: #DDA0DD;
      font-weight: 600;
    }

    .timeline-item {
      background: rgba(75, 0, 130, 0.15);
      border-left: 4px solid #4B0082;
      padding: 12px 16px;
      margin: 12px 0;
      border-radius: 6px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    
    .timeline-item strong {
      color: #9370DB;
      font-weight: 600;
    }

    /* Gallery Button */
    .gallery-btn {
      display: block;
      margin: 32px auto;
      padding: 16px 32px;
      font-size: 1.1rem;
      background-image: url('nameplate.jpg');
      background-size: cover;
      background-repeat: no-repeat;
      background-position: center;
      color: rgba(255, 255, 255, 0.9);
      font-weight: bold;
      text-shadow: 1px 1px 2px black;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 16px #0004;
      text-decoration: none;
      text-align: center;
      max-width: 250px;
    }
    
    .gallery-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 20px #0006;
    }

    /* Footer */
    footer {
      width: 100%;
      text-align: center;
      color: #DC143C;
      font-size: 1rem;
      text-shadow: 1px 1px 4px #000a;
      padding: 18px 0 12px 0;
      background: rgba(0, 0, 0, 0.85);
      border-top: 2px solid #DC143C;
      margin-top: auto;
    }
    
    footer a {
      color: #DC143C;
      text-decoration: none;
    }
    
    footer a:hover {
      text-decoration: underline;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .character-grid {
        grid-template-columns: 1fr;
        gap: 16px;
        max-width: 100%;
      }
      
      .quick-ref-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }
      
      .character-title {
        font-size: 2rem;
      }
      
      .section {
        padding: 16px;
      }
      
      main {
        padding: 12px;
      }
    }
  </style>
</head>
