<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <link rel='stylesheet' href='styles.css'>
    
    
  <title>Bluma Gallery</title>
  <link rel="stylesheet" href="styles-mobile.css" media="only screen and (max-width: 500px)">
  <style>
    body {
      margin: 0;
      font-family: 'Trebuchet MS', Tahoma, sans-serif;
      background: linear-gradient(135deg, #2d0a0a 0%, #8B0000 50%, #DC143C 100%);
      min-height: 100vh;
      background-attachment: fixed;
    }

    /* Character Title Header */
    .character-header {
      text-align: center;
      padding: 40px 20px;
      background: rgba(220, 20, 60, 0.1);
      border-bottom: 3px solid #DC143C;
      margin-bottom: 30px;
    }

    .character-title {
      font-size: 3rem;
      color: #DC143C;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
      margin: 0;
      font-weight: bold;
    }

    .character-subtitle {
      font-size: 1.2rem;
      color: #FF6B6B;
      margin: 10px 0 0 0;
      font-style: italic;
    }

    header {
      background: linear-gradient(135deg, #DC143C, #8B0000);
      padding: 15px 25px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      border-bottom: 2px solid #2d0a0a;
    }

    .home-link {
      text-decoration: none;
      color: #2d0a0a;
      font-size: 18px;
      font-weight: bold;
      transition: all 0.3s ease;
      padding: 8px 15px;
      border-radius: 5px;
    }

    .home-link:hover {
      background: rgba(45, 10, 10, 0.1);
      transform: translateX(-5px);
    }

    .gallery-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 25px;
      padding: 30px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .image-card {
      background: linear-gradient(145deg, #FF6B6B, #DC143C);
      border-radius: 15px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
      overflow: hidden;
      text-align: center;
      padding: 15px;
      transition: all 0.4s ease;
      border: 2px solid #8B0000;
      position: relative;
    }

    .image-card:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 15px 35px rgba(220, 20, 60, 0.4);
    }

    .image-card img {
      width: 100%;
      border-radius: 12px;
      border: 3px solid #8B0000;
      transition: all 0.3s ease;
    }

    .image-card:hover img {
      border-color: #2d0a0a;
    }

    .image-card button {
      margin-top: 15px;
      padding: 12px 20px;
      background: linear-gradient(135deg, #8B0000, #2d0a0a);
      color: #DC143C;
      border: 2px solid #DC143C;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.3s ease;
      text-transform: uppercase;
      font-size: 0.9rem;
    }

    .image-card button:hover {
      background: linear-gradient(135deg, #2d0a0a, #8B0000);
      color: #FF6B6B;
      border-color: #FF6B6B;
      transform: scale(1.05);
    }

    .popup {
      display: none;
      position: fixed;
      z-index: 100;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: rgba(45, 10, 10, 0.9);
      justify-content: center;
      align-items: center;
      backdrop-filter: blur(5px);
    }

    .popup-content {
      display: flex;
      background: linear-gradient(145deg, #FF6B6B, #DC143C);
      border-radius: 20px;
      max-width: 1000px;
      width: 90%;
      padding: 30px;
      position: relative;
      border: 3px solid #8B0000;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    }

    .popup-content img {
      width: 350px;
      max-width: 100%;
      height: auto;
      border-radius: 15px;
      margin-right: 25px;
      box-shadow: 0 10px 25px rgba(45, 10, 10, 0.4);
      border: 3px solid #8B0000;
    }

    .popup-content .description {
      width: 50%;
      text-align: left;
      color: #2d0a0a;
      font-size: 1rem;
      line-height: 1.6;
    }

    .popup-content .description p {
      margin: 0;
      padding: 15px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      border-left: 4px solid #8B0000;
    }

    .close-popup {
      position: absolute;
      top: 15px;
      right: 20px;
      font-size: 28px;
      color: #2d0a0a;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }

    .close-popup:hover {
      background: rgba(139, 0, 0, 0.8);
      color: #DC143C;
      transform: scale(1.1);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .character-title {
        font-size: 2rem;
      }
      
      .popup-content {
        flex-direction: column;
        width: 95%;
        padding: 20px;
      }
      
      .popup-content img {
        width: 100%;
        margin-right: 0;
        margin-bottom: 20px;
      }
      
      .popup-content .description {
        width: 100%;
      }
      
      .gallery-container {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        padding: 20px;
      }
    }
  </style>
</head>
