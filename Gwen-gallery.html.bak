<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <link rel='stylesheet' href='styles.css'>
    
    
  <title>Gwen Gallery</title>
  <link rel="stylesheet" href="styles-mobile.css" media="only screen and (max-width: 500px)">
  <style>
    body {
      margin: 0;
      font-family: 'Trebuchet MS', Tahoma, sans-serif;
      background: linear-gradient(135deg, #1e3a5f 0%, #4682B4 50%, #87CEEB 100%);
      min-height: 100vh;
      background-attachment: fixed;
    }

    /* Character Title Header */
    .character-header {
      text-align: center;
      padding: 40px 20px;
      background: rgba(135, 206, 235, 0.1);
      border-bottom: 3px solid #87CEEB;
      margin-bottom: 30px;
    }

    .character-title {
      font-size: 3rem;
      color: #87CEEB;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
      margin: 0;
      font-weight: bold;
    }

    .character-subtitle {
      font-size: 1.2rem;
      color: #B0E0E6;
      margin: 10px 0 0 0;
      font-style: italic;
    }

    header {
      background: linear-gradient(135deg, #87CEEB, #4682B4);
      padding: 15px 25px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      border-bottom: 2px solid #1e3a5f;
    }

    .home-link {
      text-decoration: none;
      color: #1e3a5f;
      font-size: 18px;
      font-weight: bold;
      transition: all 0.3s ease;
      padding: 8px 15px;
      border-radius: 5px;
    }

    .home-link:hover {
      background: rgba(30, 58, 95, 0.1);
      transform: translateX(-5px);
    }

    .gallery-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 25px;
      padding: 30px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .image-card {
      background: linear-gradient(145deg, #B0E0E6, #87CEEB);
      border-radius: 15px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
      overflow: hidden;
      text-align: center;
      padding: 15px;
      transition: all 0.4s ease;
      border: 2px solid #4682B4;
      position: relative;
    }

    .image-card:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 15px 35px rgba(135, 206, 235, 0.4);
    }

    .image-card img {
      width: 100%;
      border-radius: 12px;
      border: 3px solid #4682B4;
      transition: all 0.3s ease;
    }

    .image-card:hover img {
      border-color: #1e3a5f;
    }

    .image-card button {
      margin-top: 15px;
      padding: 12px 20px;
      background: linear-gradient(135deg, #4682B4, #1e3a5f);
      color: #87CEEB;
      border: 2px solid #87CEEB;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.3s ease;
      text-transform: uppercase;
      font-size: 0.9rem;
    }

    .image-card button:hover {
      background: linear-gradient(135deg, #1e3a5f, #4682B4);
      color: #B0E0E6;
      border-color: #B0E0E6;
      transform: scale(1.05);
    }

    .popup {
      display: none;
      position: fixed;
      z-index: 100;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: rgba(30, 58, 95, 0.9);
      justify-content: center;
      align-items: center;
      backdrop-filter: blur(5px);
    }

    .popup-content {
      display: flex;
      background: linear-gradient(145deg, #B0E0E6, #87CEEB);
      border-radius: 20px;
      max-width: 1000px;
      width: 90%;
      padding: 30px;
      position: relative;
      border: 3px solid #4682B4;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    }

    .popup-content img {
      width: 350px;
      max-width: 100%;
      height: auto;
      border-radius: 15px;
      margin-right: 25px;
      box-shadow: 0 10px 25px rgba(30, 58, 95, 0.4);
      border: 3px solid #4682B4;
    }

    .popup-content .description {
      width: 50%;
      text-align: left;
      color: #1e3a5f;
      font-size: 1rem;
      line-height: 1.6;
    }

    .popup-content .description p {
      margin: 0;
      padding: 15px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      border-left: 4px solid #4682B4;
    }

    .close-popup {
      position: absolute;
      top: 15px;
      right: 20px;
      font-size: 28px;
      color: #1e3a5f;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }

    .close-popup:hover {
      background: rgba(70, 130, 180, 0.8);
      color: #87CEEB;
      transform: scale(1.1);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .character-title {
        font-size: 2rem;
      }
      
      .popup-content {
        flex-direction: column;
        width: 95%;
        padding: 20px;
      }
      
      .popup-content img {
        width: 100%;
        margin-right: 0;
        margin-bottom: 20px;
      }
      
      .popup-content .description {
        width: 100%;
      }
      
      .gallery-container {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        padding: 20px;
      }
    }
  </style>
</head>
