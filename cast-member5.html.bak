<div class="container">
  <div class="section">
    <img src="Rinn-description.jpg" alt="Description Image" loading="lazy">
    <h2>Description</h2>
    <p>Write the character's appearance, demeanor, etc here...</p>
  </div>
  <div class="section">
    <img src="Rinn-personal.jpg" alt="Personal Info Image" loading="lazy">
    <h2>Personal Info</h2>
    <p>Details like age, gender, species, etc go here...</p>
  </div>
  <div class="section">
    <img src="Rinn-background.jpg" alt="Background Image" loading="lazy">
    <h2>Background</h2>
    <p>Backstory and important life events here...</p>
  </div>
  <div class="section">
    <img src="Rinn-goals.jpg" alt="Goals and Dreams Image" loading="lazy">
    <h2>Goals and Dreams</h2>
    <p>Motivations, hopes, and dreams go here...</p>
  </div>
</div>

<a href="Rinn-gallery.html" class="gallery-btn">See Gallery</a>

<div class="gallery" id="gallery">
  <span class="close-btn" onclick="toggleGallery()">&times;</span>
  
</div>

<script>
  function toggleGallery() {
    const gallery = document.getElementById('gallery');
    gallery.style.display = gallery.style.display === 'flex' ? 'none' : 'flex';
  }
</script>

